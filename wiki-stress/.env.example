# Owner/migration role. ETL and the Go API instead connect with the
# ukstress_etl / ukstress_api roles created by db/migrations/005_roles.sql
# (read-write and read-only respectively); see docs/operations.md.
DATABASE_URL=postgresql://ukstress_owner:ukstress_owner@localhost:5432/ukstress
UKSTRESS_DUMP_URL=https://dumps.wikimedia.org/ukwiktionary/latest/ukwiktionary-latest-pages-articles.xml.bz2
UKSTRESS_OUTPUT_DIR=output
UKSTRESS_MAX_PAGE_BYTES=8388608

# Go API (api/internal/config/config.go); only DATABASE_URL and
# LISTEN_ADDRESS are commonly overridden, the rest have sane defaults.
LISTEN_ADDRESS=:8080

# Azure AI Foundry - default project
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Annotation deployments (ml/src/ukstress_ml/annotate.py).
#
# LABEL accepts either the AZURE_OPENAI_* names below or the
# AZURE_FOUNDRY_OPENAI_* names the Foundry portal emits; the former win when
# both are set. AZURE_OPENAI_DEPLOYMENT names the model actually called.
AZURE_FOUNDRY_OPENAI_BASE_URL=
AZURE_FOUNDRY_OPENAI_API_KEY=
AZURE_FOUNDRY_OPENAI_MODEL=
#
# VERIFY is a SEPARATE deployment on purpose and has no fallback: blind
# verification exists so a model never confirms its own labels, and it rejected
# 12.9% of them in the corpus build. `ukstress-ml label --job verify` refuses to
# run when these resolve to the same model as LABEL. Leave unset until a second
# deployment exists — the refusal is the correct behaviour, not a blocker to
# work around.
AZURE_OPENAI_ENDPOINT_VERIFY=
AZURE_OPENAI_API_KEY_VERIFY=
AZURE_OPENAI_DEPLOYMENT_VERIFY=

# Azure OpenAI-compatible endpoint (for openai SDK / v1 inference API)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_V3=

# Azure AI Foundry - additional project (suffix with a project name as needed)
AZURE_AI_FOUNDRY_API_KEY_INITAITESTING=
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT_INITAITESTING=
AZURE_OPENAI_ENDPOINT_INITAITESTING=
AZURE_OPENAI_API_KEY_INITAITESTING=
AZURE_OPENAI_DEPLOYMENT_INITAITESTING=
