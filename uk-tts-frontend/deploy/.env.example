# Paths the compose stack mounts. Copy to deploy/.env and adjust.

# The ukstress checkout (PostgreSQL lexicon, stress API, cross-encoder service).
UKSTRESS_DIR=../../wiki-stress

# The contextual cross-encoder directory. It must contain `checkpoint/` and a
# `serving_manifest.json` beside it.
STRESS_MODEL_DIR=../../wiki-stress/output/ml/models/v19-v10

# A spaCy Ukrainian model directory, e.g. uk_core_news_sm (MIT).
SPACY_MODEL_DIR=../../wiki-stress/models/uk_core_news_sm

# The same manifest, plus the two lookup tables the stress API reads.
SERVING_MANIFEST=../../wiki-stress/output/ml/models/v19-v10/serving_manifest.json
SUFFIX_TABLE=../../wiki-stress/output/ml/suffix_table.json
TRIE_DEFAULTS=../../wiki-stress/output/ml/trie_defaults_map.json

# Must equal the manifest's own `inventory_hash`, or the API refuses the model.
ACTIVE_INVENTORY_HASH=759baefd94a6d8bc865f0a93ff378542b7a2b65dd58617c3194bdf85746c2769

# The Marian verbalizer checkpoint directory: the E54 release of
# github.com/vacuum-in/marian-uk-verbalizer, downloaded with
#   hf download aloudreader/marian-uk-verbalizer --local-dir ../../verbolizer/marian-uk-verbalizer-e54
VERBALIZER_CHECKPOINT=../../verbolizer/marian-uk-verbalizer-e54

# The stress-model container reads a mounted checkpoint owned by this uid.
HOST_UID=1000
HOST_GID=1000

# Ports and credentials.
FRONTEND_PORT=8000
STRESS_API_PORT=8080
UI_PORT=7861
POSTGRES_PASSWORD=ukstress_owner
API_PASSWORD=ukstress_api
