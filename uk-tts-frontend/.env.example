# Stage 1 — verbalization. Point this at a Marian checkpoint directory
# (config.json, weights, source.spm/target.spm). There is no default: the
# location is a property of the deployment, and an unset value fails loudly
# rather than quietly serving unverbalized text.
UKTTS_VERBALIZER_CHECKPOINT=
UKTTS_VERBALIZER_DEVICE=auto
UKTTS_BATCH_SIZE=8
UKTTS_NUM_BEAMS=1
UKTTS_MAX_SOURCE_TOKENS=384

# Stage 2 — stress placement, served by the ukstress API.
UKTTS_STRESS_URL=http://127.0.0.1:8080
UKTTS_ON_AMBIGUITY=default
UKTTS_STRESS_TIMEOUT=30

# Send a chunk to the verbalizer only when it holds a number, a Latin word, a
# symbol or an abbreviation. Off, the checkpoint rewrites roughly a quarter of
# plain Ukrainian sentences into something else.
UKTTS_ROUTE=1

# Set either to 0 to run one stage only.
UKTTS_VERBALIZE=1
UKTTS_STRESS=1
